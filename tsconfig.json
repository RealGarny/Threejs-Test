{
	"compilerOptions": {
		"target": "es2020",
		"module": "esnext",
		"allowJs": true,
		"outDir": "./dist/",
		"paths": {
			"@/*": ["./src/*"]
		},
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noImplicitAny": true,
		"skipLibCheck": true
	},
	"ts-node": {
		"compilerOptions": {
			"module": "CommonJS"
		}
	}
}
